{
  "redirects": [
    { "source": "/about.html", "destination": "/#about", "permanent": true },
    { "source": "/book.html", "destination": "/talks.html#book", "permanent": true },
    { "source": "/hoops-creating-hope.html", "destination": "/#impact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
